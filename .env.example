# Optional override; the default canonical origin is src/config/site-identity.json.
NEXT_PUBLIC_PRIMARY_SITE_URL=https://tsc-fm.dmirlab.com
# Public HTML verification token, provided by the site owner's Search Console.
GOOGLE_SITE_VERIFICATION=
# Public HTML verification token supplied by Bing Webmaster Tools (optional).
BING_SITE_VERIFICATION=

# Server-side Supabase submission backend. The publishable key is intentionally
# kept out of the browser bundle so submissions must pass through site validation.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-side email notification after a submission is safely stored.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUBMISSION_NOTIFICATION_EMAIL=benchmark-owner@example.com
