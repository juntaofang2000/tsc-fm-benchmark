NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_PRIMARY_SITE_URL=https://tsc-fm-benchmark.vercel.app

# Server-side Supabase submission backend. The publishable key is intentionally
# kept out of the browser bundle so submissions must pass through site validation.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-side email notification after a submission is safely stored.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUBMISSION_NOTIFICATION_EMAIL=benchmark-owner@example.com
